#!/bin/sh

. "${PVTEST_LIBDIR:-/usr/share/pantavisor/pvtest}/utils"

# ingress.pantahub.com serves a self-signed certificate and answers 404 to
# everything: a TLS failure means no response, an unverified connection a 404.
# Remote control is enabled by OEM config in a posted revision, not in
# test.json, so the framework does not wait for a claim state the device can
# never reach against that host.
phconf=/run/pantavisor/pv/phconfig/pantahub.config
conf_value() {
	pvcontrol conf ls | jq -r --arg k "$1" '.[] | select(.key == $k) | .value | select(. != "(null)")'
}
oem=$(conf_value PV_OEM_NAME)
policy=$(conf_value PV_POLICY)
rev=locals/hub-certificate-verification
fake_id=000000000000000000000000
tmp=$(mktemp -d)

[ -n "$oem" ] \
	|| { echo "ERROR: PV_OEM_NAME not set" >&2; rm -rf "$tmp"; exit 1; }

put_file() {
	local staged
	staged=$(pv_stage_file "$1") || return 1
	pv_exec cp "$staged" "$2" || return 1
	pv_unstage_file "$staged"
}

reboot_and_wait() {
	local cur
	cur=$(pvcontrol devmeta ls | jq -r '.["pantavisor.revision"]')
	pvcontrol commands reboot "pvtest: $1" > /dev/null 2>&1
	wait_for_down 30 && wait_for_target_ready "$1" "$cur" DONE > /dev/null 2>&1
}

set_phconf() {
	put_file "$1" "$phconf" && reboot_and_wait "$2"
}

restore_phconf() {
	set_phconf "$tmp/phconf" "after pantahub.config restore" \
		|| echo "ERROR: could not restore pantahub.config" >&2
	rm -rf "$tmp"
}

pv_fetch_file "$phconf" "$tmp/phconf" && [ -s "$tmp/phconf" ] \
	|| { echo "ERROR: could not fetch pantahub.config" >&2; rm -rf "$tmp"; exit 1; }
trap restore_phconf EXIT

echo "== post revision enabling remote control in OEM config =="
pvr_clone_local_or_die "$tmp/checkout"
cd "$tmp/checkout"
mkdir -p "$oem"
printf 'PV_CONTROL_REMOTE=1\nPV_CONTROL_REMOTE_ALWAYS=1\n' > "$oem/${policy:-default}.config"
pvr add . > /dev/null 2>&1
pvr commit > /dev/null 2>&1
pvr post --rev "$rev" > /dev/null 2>&1
cd /
wait_for_target_ready "after OEM config post" "$rev" "DONE|UPDATED" > /dev/null 2>&1 \
	|| { echo "ERROR: timeout waiting for $rev" >&2; exit 1; }

echo "== remove creds and reboot =="
grep -v -e '^PH_CREDS_ID=' -e '^PH_CREDS_PRN=' -e '^PH_CREDS_SECRET=' "$tmp/phconf" > "$tmp/phconf.unclaimed"
set_phconf "$tmp/phconf.unclaimed" "after reboot unclaimed" \
	|| { echo "ERROR: device did not come back after reboot" >&2; exit 1; }

log="$(pv_storage_dir)/logs/current/pantavisor/pantavisor.log"

echo "== wait for register state =="
wait_for_value "pvcontrol devmeta ls | jq -r '.\"pantahub.state\"'" "register" 60 \
	|| { echo "ERROR: timeout waiting for pantahub.state register" >&2; exit 1; }
pvcontrol devmeta ls | jq -M -r '.["pantahub.state"]'

echo "== register attempts fail TLS =="
wait_for_value "[ \$(pv_exec grep -cE \"POST /devices/ (got no response|returned HTTP error)\" $log) -ge 3 ] && echo ok" "ok" 60 \
	|| { echo "ERROR: timeout waiting for register attempts" >&2; exit 1; }
pv_exec grep -q 'POST /devices/ returned HTTP error (code=404' "$log" \
	&& echo "404 received: yes" || echo "404 received: no"

echo "== inject fake claimed creds and reboot =="
{
	cat "$tmp/phconf.unclaimed"
	echo "PH_CREDS_ID=$fake_id"
	echo "PH_CREDS_PRN=prn:::devices:/$fake_id"
	echo "PH_CREDS_SECRET=pvtest"
} > "$tmp/phconf.claimed"
set_phconf "$tmp/phconf.claimed" "after reboot claimed" \
	|| { echo "ERROR: device did not come back after reboot" >&2; exit 1; }

echo "== wait for login state =="
wait_for_value "pvcontrol devmeta ls | jq -r '.\"pantahub.state\"'" "login" 60 \
	|| { echo "ERROR: timeout waiting for pantahub.state login" >&2; exit 1; }
pvcontrol devmeta ls | jq -M -r '.["pantahub.state"]'

echo "== login attempts fail TLS =="
wait_for_value "[ \$(pv_exec grep -cE \"did not get any response|returned 404\" $log) -ge 3 ] && echo ok" "ok" 60 \
	|| { echo "ERROR: timeout waiting for login attempts" >&2; exit 1; }
pvcontrol devmeta ls | jq -M -r '.["pantahub.online"]'
pv_exec grep -q 'returned 404' "$log" && echo "404 received: yes" || echo "404 received: no"

echo "== cleanup =="
