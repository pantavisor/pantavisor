#!/bin/sh
#
# Consumer D-Bus on-owner activation on the hosted system bus.
#
# pv-example-system-dbus-client-onowner requires
# {"type":"dbus","role":"operator","names":[{"name":"org.freedesktop.Avahi",
# "activation":{"mode":"on-owner"}}]} and ships status_goal MOUNTED, so at
# boot its volumes are mounted but no process runs. pv-avahi is itself
# passive (on-demand, status_goal MOUNTED, nobody owns org.freedesktop.Avahi
# yet), so with nobody calling it both containers just sit MOUNTED -- that is
# the design, not a stall. pv-example-system-dbus-client is the always-on
# caller (role "operator", legacy socket form, STARTED at boot, and its
# built-in loop only ever dials org.pantavisor.Example, never Avahi); its
# first manual call here is what wakes pv-avahi. Once org.freedesktop.Avahi
# gains an owner, pv-xconnect's ownership monitor (NameOwnerChanged, backed
# by the 5s periodic reconcile in xconnect/main.c) promotes the on-owner
# consumer MOUNTED -> STARTED on its own, with nobody having called it.

ADDR="unix:path=/run/dbus/system_bus_socket"
CALLER="pv-example-system-dbus-client"
OWNER="pv-avahi"
CONSUMER="pv-example-system-dbus-client-onowner"
SVC="org.freedesktop.Avahi"
OBJ="/"
IFACE="org.freedesktop.Avahi.Server"

dsend() {
	# Exec dbus-send directly inside the given container (not via "sh -c":
	# under pventer a busybox "sh -c" wrapper swallows dbus-send's stdout).
	container="$1"
	shift
	# shellcheck disable=SC2086
	pventer -c "$container" \
		env DBUS_SYSTEM_BUS_ADDRESS="$ADDR" \
		dbus-send --system --print-reply $* 2>&1
}

state_of() {
	pvcontrol containers ls | tr -d '\r' \
		| jq -M -c --arg n "$1" 'map(select(.name == $n))[0] | {status, status_goal}'
}

name_has_owner() {
	dsend "$CALLER" "--dest=org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus.NameHasOwner string:$SVC" \
		| grep -o "boolean \(true\|false\)"
}

# Wait for the always-on caller to be up so pventer has a pid to enter, and
# so the device has settled before we assert idleness below.
wait_for_value "pvcontrol containers ls | jq -r '.[] | select(.name == \"$CALLER\") | .status'" "STARTED" 60 > /dev/null 2>&1 \
	|| { echo "ERROR: timeout waiting for $CALLER STARTED" >&2; exit 1; }

echo "== on-owner dependency is visible in the xconnect graph: $CONSUMER -> $SVC =="
pvcontrol graph ls | tr -d '\r' \
	| jq -M -c --arg n "$SVC" --arg c "$CONSUMER" \
	'.[] | select(.consumes == $n and .consumer == $c) | {consumes, consumer, owner, activation}'

echo "== passive-on-passive: owner and on-owner consumer both stay MOUNTED until $SVC is called =="
# Bounded settle window: nobody has called $SVC yet, so give pv-xconnect's
# periodic reconcile (5s timer) a couple of cycles to run before asserting
# idleness, to show this isn't just "too soon to tell".
sleep 12
state_of "$OWNER"
state_of "$CONSUMER"
name_has_owner

echo "== $CALLER's first call to $SVC activates the passive owner $OWNER =="
if dsend "$CALLER" "--dest=$SVC $OBJ $IFACE.GetVersionString" | grep -q 'string "avahi'; then
	echo "cold GetVersionString: OK"
else
	echo "cold GetVersionString: FAILED"
fi
wait_for_value "pvcontrol containers ls | jq -r '.[] | select(.name == \"$OWNER\") | .status'" "STARTED" 30 > /dev/null 2>&1 \
	|| echo "WARN: owner status did not reach STARTED in time" >&2
state_of "$OWNER"
name_has_owner

echo "== on-owner consumer $CONSUMER is promoted MOUNTED -> STARTED on its own =="
wait_for_value "pvcontrol containers ls | jq -r '.[] | select(.name == \"$CONSUMER\") | .status'" "STARTED" 60 > /dev/null 2>&1 \
	|| echo "WARN: consumer status did not reach STARTED in time" >&2
state_of "$CONSUMER"

echo "== $CONSUMER has its own bus socket: dbus-send roundtrip to $SVC =="
# $CONSUMER just transitioned MOUNTED -> STARTED above; pventer needs its
# cgroup set up, which can lag the STARTED status by a moment, so retry
# the roundtrip itself rather than a fixed sleep (same idiom as the
# derived-socket wait in dbus-names).
i=0
result="FAILED"
while [ $i -lt 30 ]; do
	if dsend "$CONSUMER" "--dest=$SVC $OBJ $IFACE.GetVersionString" | grep -q 'string "avahi'; then
		result="OK"
		break
	fi
	sleep 1
	i=$((i + 1))
done
echo "onowner GetVersionString: $result"
