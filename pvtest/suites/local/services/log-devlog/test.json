{
	"#spec": "pv-test@1",
	"description": "per-container /dev/log socket: capture, attribution, filetree layout and stop/start lifecycle",
	"setup": {
		"config": {
			"env": "PV_CONTROL_REMOTE=0 PV_LOG_AUTO_DEVLOG=1",
			"usrmeta": "PV_LOG_LEVEL=4 PV_LOG_SERVER_OUTPUTS=filetree"
		},
		"containers": {
			"tarballs": [
				"../../common/tarballs/pv-example-app.pvrexport.tgz"
			]
		},
		"self-claim": "false",
		"commit-initial": "false"
	},
	"test-script": "resources/test",
	"skip": "false",
	"devices": []
}
