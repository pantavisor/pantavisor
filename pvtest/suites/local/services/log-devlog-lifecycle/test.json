{
	"#spec": "pv-test@1",
	"description": "per-container /dev/log socket is created on container start and removed on stop",
	"setup": {
		"config": {
			"env": "PV_CONTROL_REMOTE=0 PV_LOG_AUTO_DEVLOG=1 PV_LOG_LEVEL=4",
			"usrmeta": ""
		},
		"containers": {
			"tarballs": [
				"../../common/tarballs/pv-example-app.pvrexport.tgz"
			]
		},
		"self-claim": "false",
		"commit-initial": "false"
	},
	"test-script": "resources/test",
	"skip": "false",
	"devices": []
}
