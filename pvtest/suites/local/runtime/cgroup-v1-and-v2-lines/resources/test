#!/bin/sh
#
# A container that carries both lxc.cgroup and lxc.cgroup2 device lines works on
# either cgroup version. On cgroup v2 the lxc.cgroup lines are left out of the
# copy of the config that LXC reads, the revision's own file stays as it is.

. "${PVTEST_LIBDIR:-/usr/share/pantavisor/pvtest}/utils"

container=pv-example-app

checkout="$(mktemp -d)/checkout"
pvr_clone_local_or_die "$checkout"
cd "$checkout"

container_status() {
	pvcontrol containers ls | jq -r --arg n "$container" 'map(select(.name == $n))[0].status'
}

log_root=$(pvcontrol conf ls | jq -r '.[] | select(.key == "PV_LOG_DIR") | .value')
pantavisor_log="${log_root%/}/current/pantavisor/pantavisor.log"
lxc_dir=$(pvcontrol conf ls | jq -r '.[] | select(.key == "PV_SYSTEM_LXCDIR") | .value')
used_conf="$lxc_dir/$container.conf"

echo "== cgroup layout of the device =="
pv_exec stat -fc %T /sys/fs/cgroup | tr -d '\r'

echo "== post a revision with lxc.cgroup and lxc.cgroup2 device lines =="
conf="$container/lxc.container.conf"
grep -vE '^[[:space:]]*lxc\.cgroup2?\.devices\.' "$conf" > "$conf.new"
mv "$conf.new" "$conf"
{
	echo "lxc.cgroup.devices.deny = a"
	echo "lxc.cgroup.devices.allow = c 1:3 rwm"
	echo "lxc.cgroup2.devices.deny = a"
	echo "lxc.cgroup2.devices.allow = c 1:3 rwm"
} >> "$conf"
pvr add "$conf" > /dev/null 2>&1
pvr commit -m "lxc.cgroup and lxc.cgroup2 device lines" > /dev/null 2>&1
pvr post --rev "locals/v1-and-v2-lines" > /dev/null 2>&1
wait_for_revision_state "locals/v1-and-v2-lines" "UPDATED" > /dev/null 2>&1 \
	|| { echo "ERROR: timeout waiting for locals/v1-and-v2-lines to reach UPDATED" >&2; exit 1; }
echo "locals/v1-and-v2-lines: UPDATED"

echo "== container is running =="
wait_for_value 'container_status' "STARTED" 60 > /dev/null 2>&1 \
	|| { echo "ERROR: timeout waiting for $container to reach STARTED" >&2; exit 1; }
echo "$container: $(container_status)"

echo "== config that LXC reads =="
pv_fetch_file "$used_conf" "$checkout/used.conf"
echo "lxc.cgroup device lines: $(grep -cE '^lxc\.cgroup\.devices\.' "$checkout/used.conf")"
echo "lxc.cgroup2 device lines: $(grep -cE '^lxc\.cgroup2\.devices\.' "$checkout/used.conf")"

echo "== log names the removed lines =="
pv_fetch_file "$pantavisor_log" "$checkout/pantavisor.log"
for text in \
	"container '$container': removed 'lxc.cgroup.devices.deny = a'" \
	"container '$container': removed 'lxc.cgroup.devices.allow = c 1:3 rwm'"; do
	if grep -qF "$text" "$checkout/pantavisor.log"; then
		echo "logged: $text"
	else
		echo "NOT logged: $text"
	fi
done
