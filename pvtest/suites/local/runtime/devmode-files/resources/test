#!/bin/sh
#
# pvcontrol devmode files ls|get|put|rm|mv|chmod (GET, PUT and DELETE on
# /devmode/files/<container>[/<path>]).
#
# - refused while devmode is not allowed and while no devmode revision runs
# - a file is stored from standard input or from a file, with a mode
# - the list shows what was changed, with the sha256 of each file
# - get returns the file as the container sees it
# - removing a file of the image is listed as deleted and get does not find it
# - mv renames a file or a directory, also into a directory that is new
# - chmod changes the mode and the owner without sending the file again
# - an error carries the errno next to the message
# - paths with .. are refused; a symlink in the container cannot lead out of it
# - a container with the mgmt role can use it, one without the role cannot
# - after a restart the container sees the files

. "${PVTEST_LIBDIR:-/usr/share/pantavisor/pvtest}/utils"

target="pv-example-norole"
mgmt="pv-example-mgmt"
image_file="usr/bin/curl"

devmode_init
work=$(mktemp -d)
cleanup() {
	rm -rf "$work"
	devmode_cleanup
}
trap cleanup EXIT

# run a command and print its exit code and what it said on stderr
failing() {
	local err
	err=$("$@" 2>&1 > /dev/null)
	echo "exit: $?"
	echo "$err" | tr -d '\r' | grep -v -e '^$' -e '^/usr/bin/fallbear-cmd'
}

# the list of the container, one line per entry; the sha256 stays out of the
# paths line so it shows only what changed
list_paths() {
	pvcontrol devmode files ls "$target" | jq -M -c '[.files[].path]'
}

in_target() {
	pventer -c "$target" "$@" 2>&1 | tr -d '\r' | grep -v -e '^$' -e '^/usr/bin/fallbear-cmd'
}

echo "== refused while devmode is not allowed =="
failing pvcontrol devmode files ls "$target"

echo "== refused while no devmode revision runs =="
failing pvcontrol devmode files ls "$target"
failing pvcontrol devmode files put "$target" etc/x /dev/null

echo "== run a devmode revision =="
devmode_create "devmode revision" || exit 1

echo "== nothing changed yet =="
pvcontrol devmode files ls "$target" | jq -M -c .

echo "== put a file from standard input =="
printf 'hello from devmode\n' | pvcontrol devmode files put "$target" etc/devmode-test.conf - | jq -M -c .

echo "== put a script from a file with a mode, in a directory that is new =="
printf '#!/bin/sh\necho tool\n' > "$work/tool.sh"
staged=$(pv_stage_file "$work/tool.sh") || exit 1
pvcontrol devmode files put "$target" opt/devmode-test/bin/tool.sh "$staged" --mode 0755 | jq -M -c .
pv_unstage_file "$staged"
echo "== a file that does not exist is refused =="
failing pvcontrol devmode files put "$target" etc/x /no/such/file

echo "== replace the first file =="
printf 'second version\n' | pvcontrol devmode files put "$target" etc/devmode-test.conf - | jq -M -c .

echo "== list =="
list_paths
pvcontrol devmode files ls "$target" | jq -M -c '.container, ([.files[] | select(.type == "file")] | sort_by(.path))'
pvcontrol devmode files ls "$target" | jq -M -c '[.files[] | select(.path == "opt/devmode-test/bin") | {type, mode}]'

echo "== get =="
pvcontrol devmode files get "$target" etc/devmode-test.conf
pvcontrol devmode files get "$target" opt/devmode-test/bin/tool.sh | sha256sum | cut -d' ' -f1
sha256sum < "$work/tool.sh" | cut -d' ' -f1
echo "== get a file of the image =="
pvcontrol devmode files get "$target" "$image_file" > "$work/img"
echo "get exit: $?"
inside=$(in_target sha256sum "/$image_file" | cut -d' ' -f1)
echo "same as in the container: $([ "$(sha256sum < "$work/img" | cut -d' ' -f1)" = "$inside" ] && echo yes || echo no)"
echo "== get a file that is not there =="
failing pvcontrol devmode files get "$target" etc/no-such-file

echo "== remove a file of the image =="
pvcontrol devmode files rm "$target" "$image_file" > /dev/null
echo "rm exit: $?"
pvcontrol devmode files ls "$target" | jq -M -c '.files[] | select(.type == "deleted")'
failing pvcontrol devmode files get "$target" "$image_file"
echo "== remove a file that is not there =="
failing pvcontrol devmode files rm "$target" etc/no-such-file

echo "== remove a directory needs --recursive =="
failing pvcontrol devmode files rm "$target" opt/devmode-test
pvcontrol devmode files rm "$target" opt/devmode-test --recursive > /dev/null
echo "rm recursive exit: $?"
list_paths

echo "== unsafe paths =="
failing pvcontrol devmode files put "$target" ../escape /dev/null
failing pvcontrol devmode files put "$target" etc/../../escape /dev/null
failing pvcontrol devmode files get "$target" ../etc/passwd

echo "== a symlink does not lead out of the container =="
pvcontrol devmode files put "$target" via-link --type symlink --target /etc | jq -M -c .
printf 'inside\n' | pvcontrol devmode files put "$target" via-link/devmode-link-test - | jq -M -c '.path'
pvcontrol devmode files ls "$target" | jq -M -c '[.files[] | select(.path == "via-link" or .path == "etc/devmode-link-test") | {path, type}]'
echo "on the device root: $(pv_exec test -e /etc/devmode-link-test && echo yes || echo no)"
pvcontrol devmode files rm "$target" etc/devmode-link-test > /dev/null
pvcontrol devmode files rm "$target" via-link > /dev/null

echo "== a path with a space, #, ? and % and a non-ASCII letter =="
odd='opt/odd dir/a#b?c%d-é.txt'
printf 'odd\n' | pvcontrol devmode files put "$target" "$odd" - | jq -M -c '.path'
pvcontrol devmode files get "$target" "$odd"
pvcontrol devmode files ls "$target" | jq -M -c '[.files[] | select(.type == "file" and (.path | startswith("opt/odd dir"))) | .path]'
pvcontrol devmode files put "$target" "opt/odd link" --type symlink --target 'a b#c?d' | jq -M -c .
pvcontrol devmode files ls "$target" | jq -M -c '[.files[] | select(.path == "opt/odd link") | .target]'
pvcontrol devmode files rm "$target" "opt/odd dir" --recursive > /dev/null
pvcontrol devmode files rm "$target" "opt/odd link" > /dev/null

echo "== a directory with a mode =="
pvcontrol devmode files put "$target" opt/devmode-dir --type dir --mode 0750 | jq -M -c .
pvcontrol devmode files ls "$target" | jq -M -c '[.files[] | select(.path == "opt/devmode-dir") | {type, mode}]'
pvcontrol devmode files rm "$target" opt/devmode-dir > /dev/null
echo "== a directory without a mode =="
pvcontrol devmode files put "$target" opt/devmode-plain/sub --type dir | jq -M -c .
pvcontrol devmode files ls "$target" | jq -M -c '[.files[] | select(.path | startswith("opt/devmode-plain")) | {path, mode}]'
pvcontrol devmode files rm "$target" opt/devmode-plain --recursive > /dev/null

echo "== rename a file into a directory that is new =="
printf 'rename me\n' | pvcontrol devmode files put "$target" etc/devmode-rn.conf - > /dev/null
pvcontrol devmode files mv "$target" etc/devmode-rn.conf opt/rn-new/moved.conf | jq -M -c .
pvcontrol devmode files get "$target" opt/rn-new/moved.conf
failing pvcontrol devmode files get "$target" etc/devmode-rn.conf
echo "== rename a directory =="
printf 'in dir\n' | pvcontrol devmode files put "$target" opt/rn-dir/f - > /dev/null
pvcontrol devmode files mv "$target" opt/rn-dir opt/rn-dir2 | jq -M -c .
pvcontrol devmode files get "$target" opt/rn-dir2/f
failing pvcontrol devmode files get "$target" opt/rn-dir/f
echo "== rename something that is not there =="
failing pvcontrol devmode files mv "$target" etc/no-such-file opt/rn-gone
echo "== rename onto a directory with content =="
failing pvcontrol devmode files mv "$target" opt/rn-new opt/rn-dir2
echo "== rename with a path that leaves the container =="
failing pvcontrol devmode files mv "$target" ../etc opt/rn-gone
pvcontrol devmode files rm "$target" opt/rn-new --recursive > /dev/null
pvcontrol devmode files rm "$target" opt/rn-dir2 --recursive > /dev/null

echo "== change the mode and the owner without sending the file =="
printf 'attrs\n' | pvcontrol devmode files put "$target" etc/devmode-attrs.conf - | jq -M -c '.sha256'
pvcontrol devmode files chmod "$target" etc/devmode-attrs.conf --mode 0600 --uid 1000 --gid 1001 | jq -M -c .
pvcontrol devmode files ls "$target" | jq -M -c '[.files[] | select(.path == "etc/devmode-attrs.conf") | {mode, uid, gid, sha256}]'
echo "== change only the mode =="
pvcontrol devmode files chmod "$target" etc/devmode-attrs.conf --mode 0640 > /dev/null
pvcontrol devmode files ls "$target" | jq -M -c '[.files[] | select(.path == "etc/devmode-attrs.conf") | {mode, uid, gid}]'
echo "== change only the group =="
pvcontrol devmode files chmod "$target" etc/devmode-attrs.conf --gid 1002 > /dev/null
pvcontrol devmode files ls "$target" | jq -M -c '[.files[] | select(.path == "etc/devmode-attrs.conf") | {mode, uid, gid}]'
echo "== change the owner of a symlink =="
pvcontrol devmode files put "$target" etc/devmode-attrs-link --type symlink --target devmode-attrs.conf > /dev/null
pvcontrol devmode files chmod "$target" etc/devmode-attrs-link --uid 1003 | jq -M -c .
pvcontrol devmode files ls "$target" | jq -M -c '[.files[] | select(.path == "etc/devmode-attrs-link") | {type, uid}]'
echo "== chmod needs something to change =="
failing pvcontrol devmode files chmod "$target" etc/devmode-attrs.conf
echo "== chmod of something that is not there =="
failing pvcontrol devmode files chmod "$target" etc/no-such-file --mode 0600
pvcontrol devmode files rm "$target" etc/devmode-attrs.conf > /dev/null
pvcontrol devmode files rm "$target" etc/devmode-attrs-link > /dev/null

echo "== setuid and setgid survive an owner given with the mode =="
printf 'suid\n' | pvcontrol devmode files put "$target" etc/devmode-suid.conf - --mode 4755 --uid 0 --gid 0 > /dev/null
pvcontrol devmode files ls "$target" | jq -M -c '[.files[] | select(.path == "etc/devmode-suid.conf") | {mode, uid, gid}]'
pvcontrol devmode files put "$target" opt/devmode-sgid --type dir --mode 2755 --uid 0 --gid 0 > /dev/null
pvcontrol devmode files ls "$target" | jq -M -c '[.files[] | select(.path == "opt/devmode-sgid") | {type, mode, uid, gid}]'
printf 'attrs suid\n' | pvcontrol devmode files put "$target" etc/devmode-suid-attrs.conf - > /dev/null
pvcontrol devmode files chmod "$target" etc/devmode-suid-attrs.conf --mode 4755 --uid 1000 > /dev/null
pvcontrol devmode files ls "$target" | jq -M -c '[.files[] | select(.path == "etc/devmode-suid-attrs.conf") | {mode, uid}]'
pvcontrol devmode files rm "$target" etc/devmode-suid.conf > /dev/null
pvcontrol devmode files rm "$target" etc/devmode-suid-attrs.conf > /dev/null
pvcontrol devmode files rm "$target" opt/devmode-sgid > /dev/null

echo "== an error carries the errno =="
printf 'plain\n' | pvcontrol devmode files put "$target" opt/errno-file - > /dev/null
failing sh -c "printf x | pvcontrol devmode files put '$target' opt/errno-file/below -"
failing pvcontrol devmode files rm "$target" opt/no-such-dir
pvcontrol devmode files rm "$target" opt/errno-file > /dev/null

echo "== from a container with the mgmt role =="
pventer -c "$mgmt" pvcontrol devmode files ls "$target" 2>&1 | tr -d '\r' | grep '^{' | jq -M -c '[.files[].path]'

echo "== from a container without the mgmt role =="
out=$(pventer -c "$target" curl -s -w ' %{http_code}' --unix-socket /pantavisor/pv-ctrl "http://localhost/devmode/files/$target" 2>&1 | tr -d '\r' | grep -v -e '^$' -e '^/usr/bin/fallbear-cmd')
echo "$out"
out=$(pventer -c "$target" curl -s -X PUT -w ' %{http_code}' --data x --unix-socket /pantavisor/pv-ctrl "http://localhost/devmode/files/$target/etc/not-allowed" 2>&1 | tr -d '\r' | grep -v -e '^$' -e '^/usr/bin/fallbear-cmd')
echo "$out"
echo "== an unknown container =="
failing pvcontrol devmode files ls no-such-container

echo "== the container sees the changes after a restart =="
devmode_apply_reboot "$target" "restart" || exit 1
echo "config: $(in_target cat /etc/devmode-test.conf)"
echo "image file: $(pventer -c "$target" test -e "/$image_file" && echo present || echo gone)"

echo "== reset swaps in an empty inlay =="
inlay_dir=$(pvcontrol devmode status | jq -M -r --arg c "$target" '.containers[] | select(.name == $c) | .inlay' | xargs dirname)
old_dirs() { pv_exec ls "$inlay_dir" 2>/dev/null | tr -d '\r' | grep -c '^_devmode\.old\.'; }
printf 'to be reset\n' | pvcontrol devmode files put "$target" etc/devmode-reset.conf - | jq -M -c '.path'
pvcontrol devmode reset "$target" > /dev/null
echo "reset exit: $?"
pvcontrol devmode files ls "$target" | jq -M -c .
echo "old inlays before the restart: $(old_dirs)"
pvcontrol devmode files get "$target" etc/devmode-reset.conf 2>&1 | grep -c '^{"Error"'
printf 'after reset\n' | pvcontrol devmode files put "$target" etc/devmode-after-reset.conf - | jq -M -c '.path'
devmode_apply_reboot "$target" "restart after reset" || exit 1
echo "config: $(pventer -c "$target" test -e /etc/devmode-test.conf && echo present || echo gone)"
echo "reset file: $(pventer -c "$target" test -e /etc/devmode-reset.conf && echo present || echo gone)"
echo "file put after the reset: $(pventer -c "$target" test -e /etc/devmode-after-reset.conf && echo present || echo gone)"
echo "image file: $(pventer -c "$target" test -e "/$image_file" && echo present || echo gone)"
echo "old inlays after the restart: $(old_dirs)"
