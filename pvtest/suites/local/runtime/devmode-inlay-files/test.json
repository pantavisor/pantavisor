{
	"#spec": "pv-test@1",
	"description": "a file put into an inlay with pvcontrol devmode files put shows up after a restart, survives another one and is gone after a reset",
	"setup": {
		"config": {
			"env": "PV_CONTROL_REMOTE=0",
			"usrmeta": "",
			"pantavisor": [
				"PV_DEVMODE_ALLOWED=1"
			]
		},
		"containers": {
			"tarballs": [
				"../../common/tarballs/pv-example-mgmt.pvrexport.tgz",
				"../../common/tarballs/pv-example-norole.pvrexport.tgz"
			]
		},
		"self-claim": "false",
		"commit-initial": "true"
	},
	"test-script": "resources/test",
	"skip": "false",
	"devices": ["appengine"]
}
