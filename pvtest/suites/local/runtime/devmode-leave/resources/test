#!/bin/sh
#
# Run a devmode revision with a file in a container inlay (put with the API) and reboot with
# `pvcontrol cmd reboot`: the device comes back in the devmode revision with the
# file. Then run the committed revision again: devmode is off and the container no longer sees
# the file.

. "${PVTEST_LIBDIR:-/usr/share/pantavisor/pvtest}/utils"

target="pv-example-norole"
writer="pv-example-mgmt"
file_in_target="/etc/devmode-file"

devmode_init

target_has_file() {
	pventer -c "$target" test -e "$file_in_target" && echo yes || echo no
}

echo "== run a devmode revision =="
devmode_create "devmode revision" || exit 1

echo "== write a file into the inlay of $target and restart it =="
pventer -c "$writer" pvcontrol devmode files put "$target" "${file_in_target#/}" /dev/null > /dev/null
devmode_apply_reboot "$target" "restart" || exit 1
echo "present in devmode: $(target_has_file)"
echo "devmode active: $(pvcontrol devmode status | jq -M '.active' | tr -d '\r')"

echo "== a requested reboot stays in devmode =="
reboot_err=$(mktemp)
reboot_out=$(pvcontrol cmd reboot "pvtest: stay in devmode" 2> "$reboot_err")
echo "reboot exit: $?"
echo "reboot stdout: $reboot_out" | tr -d '\r'
echo "reboot stderr: $(tr -d '\r' < "$reboot_err" | grep -v fallbear-cmd)"
rm -f "$reboot_err"
wait_for_down 30
wait_for_target_ready "reboot in devmode" "$devmode_rev" "UPDATED" >&2 \
	|| { echo "ERROR: $devmode_rev did not come back after the reboot" >&2; exit 1; }
echo "devmode active after reboot: $(pvcontrol devmode status | jq -M '.active' | tr -d '\r')"
echo "present after reboot: $(target_has_file)"

echo "== run the committed revision again =="
leave_err=$(mktemp)
leave_out=$(pvcontrol cmd run "$base_rev" 2> "$leave_err")
echo "run exit: $?"
echo "run stdout: $leave_out" | tr -d '\r'
echo "run stderr: $(tr -d '\r' < "$leave_err" | grep -v fallbear-cmd)"
rm -f "$leave_err"
wait_for_down 30
wait_for_target_ready "leave devmode" "$base_rev" "DONE|UPDATED" >&2 \
	|| { echo "ERROR: $base_rev did not come back" >&2; exit 1; }

echo "== devmode is off =="
pvcontrol devmode status | jq -M '{enabled, active, has_containers: has("containers")}' | tr -d '\r'
echo "present after leaving devmode: $(target_has_file)"
echo "devmode folder in $writer: $(pventer -c "$writer" test -e /pantavisor/devmode && echo yes || echo no)"
echo "pantavisor.devmode after leaving: $(pvcontrol devmeta ls | jq -M -r '.["pantavisor.devmode"]' | tr -d '\r')"
echo "committed revision status: $(pvcontrol steps show-progress "$base_rev" | jq -M -r '.status' | tr -d '\r')"
