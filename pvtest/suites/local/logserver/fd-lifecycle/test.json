{
	"#spec": "pv-test@1",
	"description": "logserver fd lifecycle: pv-fd-log console capture follows container restarts without leaking fds or spinning on a closed fd",
	"setup": {
		"config": {
			"env": "PV_CONTROL_REMOTE=0 PV_LOG_LEVEL=5 PV_LOG_SERVER_OUTPUTS=filetree",
			"usrmeta": ""
		},
		"containers": {
			"tarballs": [
				"../../common/tarballs/pv-example-app.pvrexport.tgz"
			]
		},
		"self-claim": "false",
		"commit-initial": "false"
	},
	"test-script": "resources/test",
	"skip": "false",
	"devices": []
}
