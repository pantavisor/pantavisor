{
	"#spec": "pv-test@1",
	"description": "logserver with a pantavisor stdout output at boot config: PV_LOG_LEVEL=6 keeps TRACE, invalid filetree timestamp falls back to --, relative tsec, dmesg skipped",
	"setup": {
		"config": {
			"env": "PV_CONTROL_REMOTE=0 PV_LOG_LEVEL=6 PV_LOG_SERVER_OUTPUTS=filetree,stdout.pantavisor PV_LOG_FILETREE_TIMESTAMP_FORMAT=golang:Nope PV_LOG_TIMESTAMP=relative PV_LOG_CAPTURE_DMESG=1",
			"usrmeta": ""
		},
		"containers": {
			"tarballs": [
				"../../common/tarballs/pv-example-norole.pvrexport.tgz"
			]
		},
		"self-claim": "false",
		"commit-initial": "false"
	},
	"test-script": "resources/test",
	"skip": "false",
	"devices": []
}
