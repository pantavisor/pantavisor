{
	"#spec": "pv-test@1",
	"description": "per-container dev-log in run.json enables /dev/log with PV_LOG_AUTO_DEVLOG off",
	"setup": {
		"config": {
			"env": "PV_CONTROL_REMOTE=0 PV_LOG_AUTO_DEVLOG=0 PV_LOG_LEVEL=4 PV_LOG_SERVER_OUTPUTS=filetree",
			"usrmeta": ""
		},
		"containers": {
			"tarballs": [
				"../../common/tarballs/pv-example-app.pvrexport.tgz",
				"../../common/tarballs/pv-example-norole.pvrexport.tgz"
			]
		},
		"self-claim": "false",
		"commit-initial": "false"
	},
	"test-script": "resources/test",
	"skip": "false",
	"devices": []
}
