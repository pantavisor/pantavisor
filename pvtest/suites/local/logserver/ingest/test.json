{
	"#spec": "pv-test@1",
	"description": "logserver ingest: every protocol on /dev/log and pv-ctrl-log, platform attribution, and malformed input dropped without killing the log server",
	"setup": {
		"config": {
			"env": "PV_CONTROL_REMOTE=0 PV_LOG_LEVEL=5 PV_LOG_AUTO_DEVLOG=1 PV_LOG_SERVER_OUTPUTS=filetree,singlefile",
			"usrmeta": ""
		},
		"containers": {
			"tarballs": [
				"../../common/tarballs/pv-example-app.pvrexport.tgz",
				"../../common/tarballs/pv-example-norole.pvrexport.tgz"
			]
		},
		"self-claim": "false",
		"commit-initial": "false"
	},
	"test-script": "resources/test",
	"skip": "false",
	"devices": []
}
