#!/bin/sh
#
# INFO heartbeat in pantavisor.log (docs/overview/storage.md#liveness-lines):
#
#   alive: revision 0, state WAIT, local mode, 1/1 containers started, running for 0h00m
#
# test.json sets PV_LOG_HEARTBEAT_INTERVAL=5 (the default is 10 minutes). The
# first line comes one interval after pantavisor settles into WAIT. The wait
# state refreshes the timer about every 2 seconds, so a change through user meta
# takes effect within that, and 0 stops the lines. PV_LOG_LEVEL=5 and a short
# PH_LOG_SUMMARY_INTERVAL are set only to show that local mode has no hub: line,
# because the Hub client is not running. Times come from the time stamp
# (seconds) of each line.

. "${PVTEST_LIBDIR:-/usr/share/pantavisor/pvtest}/utils"

LOGROOT=$(pvcontrol conf ls | jq -r '.[] | select(.key == "PV_LOG_DIR") | .value')
LOGROOT=${LOGROOT%/}
if [ -z "$LOGROOT" ]; then
	echo "ERROR: could not read PV_LOG_DIR from the target" >&2
	exit 1
fi
PVLOG="$LOGROOT/current/pantavisor/pantavisor.log"

TMP=$(mktemp -d)
trap 'pvcontrol usrmeta delete PV_LOG_HEARTBEAT_INTERVAL > /dev/null 2>&1; rm -rf "$TMP"' EXIT

# Number of heartbeat lines in the log so far
beats() { pv_exec grep -c 'alive: revision' "$PVLOG" | tr -d ' \r'; }
# Wait until there are at least $1 heartbeat lines
wait_beats() { wait_for_status "[ \"\$(beats)\" -ge $1 ]" 0 "${2:-30}"; }
fetch() { pv_fetch_file "$PVLOG" "$TMP/pantavisor.log"; tr -d '\r' < "$TMP/pantavisor.log" | grep 'alive: revision' > "$TMP/beats"; }
conf() { pvcontrol conf ls | jq -M -r --arg k PV_LOG_HEARTBEAT_INTERVAL '.[] | select(.key == $k) | "PV_LOG_HEARTBEAT_INTERVAL = \(.value) (\(.modified))"' | tr -d '\r'; }
# Wait for 4 lines starting at line number $1, then check that their average gap is between $2 and $3 seconds
pace() {
	wait_beats "$(($1 + 3))" 60 > /dev/null 2>&1 || return 1
	fetch
	sed -n "$1,$(($1 + 3))p" "$TMP/beats" | sed -n 's/^\[pantavisor\] \([0-9]*\) .*/\1/p' > "$TMP/times"
	[ "$(wc -l < "$TMP/times")" -eq 4 ] || return 1
	span=$(( $(tail -n1 "$TMP/times") - $(head -n1 "$TMP/times") ))
	echo "total ${span}s over 3 gaps, average $(awk -v s="$span" 'BEGIN { printf "%.1f", s / 3 }')s" > "$TMP/pace"
	between "$span" "$(($2 * 3))" "$(($3 * 3))"
}
yesno() { if "$@" > /dev/null 2>&1; then echo yes; else echo no; fi; }
# A late line is followed by one on the original schedule, so two neighbouring lines can be close together under load; the pace is the average over several lines
between() { [ "$1" -ge "$2" ] && [ "$1" -le "$3" ]; }

echo "== default interval from the environment =="
echo "config: $(conf)"
echo "heartbeat lines appear: $(yesno wait_beats 3 30)"
fetch
echo "last line, variable parts masked:"
tail -n1 "$TMP/beats" | sed -e 's/^.*alive: /alive: /' \
	-e 's/revision [^,]*,/revision N,/' \
	-e 's/[0-9][0-9]*\/[0-9][0-9]* containers/X\/Y containers/' \
	-e 's/running for .*/running for HhMMm/'
started=$(tail -n1 "$TMP/beats" | sed -n 's/.* \([0-9]*\)\/\([0-9]*\) containers.*/\1 \2/p')
echo "all containers started: $([ -n "$started" ] && [ "${started% *}" = "${started#* }" ] && [ "${started% *}" -gt 0 ] && echo yes || echo no)"
r=$(yesno pace "$(($(beats) + 1))" 4 10)
echo "about 5 seconds apart: $r"
cat "$TMP/pace" >&2

echo "== no Hub summary in local mode =="
# the line is at DEBUG and PH_LOG_SUMMARY_INTERVAL is 2 seconds, so any would be here by now
hubs=$(pv_exec grep -cE '\[pantahub_proto\].*hub: ([0-9]+ requests, [0-9]+ failures|no requests) in [0-9]+s \([a-z ]+\)' "$PVLOG" | tr -d ' \r')
echo "no hub: line: $([ "$hubs" = 0 ] && echo yes || echo no)"

echo "== interval changed at run time =="
pvcontrol usrmeta save PV_LOG_HEARTBEAT_INTERVAL 2 > /dev/null
echo "config: $(conf)"
# the first line after the change is the start; the pace is taken from the lines after it
B=$(beats)
wait_beats "$((B + 1))" 30 > /dev/null 2>&1
r=$(yesno pace "$((B + 2))" 1 4)
echo "about 2 seconds apart: $r"
cat "$TMP/pace" >&2

echo "== disabled with 0 =="
pvcontrol usrmeta save PV_LOG_HEARTBEAT_INTERVAL 0 > /dev/null
echo "config: $(conf)"
# one more line can still arrive from the timer already armed
sleep 4
B=$(beats)
sleep 8
echo "no new line while 0: $([ "$(beats)" = "$B" ] && echo yes || echo no)"
